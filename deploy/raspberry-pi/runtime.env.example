# Used by run.sh and systemd; keep to plain KEY=value assignments.
FACTORY_MODE=hybrid
FACTORY_WEB_HOST=0.0.0.0
FACTORY_WEB_PORT=5001
FACTORY_MQTT_HOST=127.0.0.1
FACTORY_MQTT_PORT=1883
# Optional broker login; fill only runtime.env, never this tracked example.
FACTORY_MQTT_USERNAME=''
FACTORY_MQTT_PASSWORD=''
FACTORY_ENV_TOPIC=factory/workshop1/env
FACTORY_ALERT_TOPIC=factory/workshop1/alert
PYTHONUNBUFFERED=1
# Data and mail default to this independent repository's data/ and mail.ini.
